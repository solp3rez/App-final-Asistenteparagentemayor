{
  "expo": {
    "name": "Cerca",
    "slug": "cerca",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "cerca",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permití acceder a tus fotos para elegir una foto de perfil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
